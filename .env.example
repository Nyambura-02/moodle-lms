# ==============================================================================
# GlobeCon Convergence Solutions - LMS Environment Configuration (.env.example)
# DO NOT COMMIT ACTUAL SENSITIVE CREDENTIALS TO VERSION CONTROL
# Copy this file to .env and replace placeholder values with environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Moodle Site Configuration
# ------------------------------------------------------------------------------
MOODLE_SITE_NAME="GlobeCon Convergence Solutions Learning Portal"
MOODLE_SHORT_NAME="GlobeCon LMS"
# For local development: http://localhost:8000 or http://localhost
# For production: https://lms.globecon.com (Must use HTTPS in production)
MOODLE_URL="http://localhost:8000"
MOODLE_PORT=8000

# ------------------------------------------------------------------------------
# Administrator Account (Initial Setup)
# ------------------------------------------------------------------------------
MOODLE_ADMIN_USER="globecon_admin"
MOODLE_ADMIN_PASSWORD="ChangeMe_StrictPassword123!"
MOODLE_ADMIN_EMAIL="admin@globecon.local"

# ------------------------------------------------------------------------------
# Database Configuration (MariaDB / MySQL / PostgreSQL)
# ------------------------------------------------------------------------------
DB_TYPE="mariadb"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="moodle"
DB_USER="moodleuser"
DB_PASSWORD="ChangeMe_DatabaseSecret123!"
DB_PREFIX="mdl_"

# ------------------------------------------------------------------------------
# Moodle Data Directory (Must NOT be accessible from the public web server)
# ------------------------------------------------------------------------------
# In local portable environment, this is inside ./server/moodledata or a dedicated folder
MOODLE_DATA_DIR="./moodledata"

# ------------------------------------------------------------------------------
# Mail / SMTP Notification Settings (Configure when authorized mail host is active)
# ------------------------------------------------------------------------------
MOODLE_SMTP_HOST=""
MOODLE_SMTP_PORT=587
MOODLE_SMTP_USER=""
MOODLE_SMTP_PASSWORD=""
MOODLE_SMTP_SECURITY="tls"
MOODLE_NOREPLY_ADDRESS="noreply@globecon.com"

# ------------------------------------------------------------------------------
# Docker Stack Settings (For containerized deployment)
# ------------------------------------------------------------------------------
DOCKER_APP_PORT=8000
DOCKER_DB_PORT=3306
DOCKER_MARIADB_ROOT_PASSWORD="ChangeMe_RootSecret123!"
