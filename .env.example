# ==============================================================================
# GlobeCon Convergence Solutions - LMS Environment Configuration (.env.example)
# DO NOT COMMIT ACTUAL SENSITIVE CREDENTIALS TO VERSION CONTROL
# Primary Theme: Corporate Blue (#1e3a8a, #2563eb) & Violet (#6366f1)
# Copy this file to .env and configure secrets for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Site & Corporate Identity
# ------------------------------------------------------------------------------
MOODLE_SITE_NAME="GlobeCon Convergence Solutions Learning Portal"
MOODLE_SHORT_NAME="GlobeCon LMS"
# For local development: http://localhost:8000
# For production: https://lms.globecon.com (Must use HTTPS in production)
MOODLE_URL="http://localhost:8000"
MOODLE_PORT=8000
MOODLE_TIMEZONE="Africa/Nairobi"
MOODLE_COUNTRY="KE"
SUPPORT_PHONE="+254 116 993 399"
SUPPORT_EMAIL="support@globecon.ac.ke"

# ------------------------------------------------------------------------------
# Theme & Branding Configuration (Blue & Violet Theme)
# ------------------------------------------------------------------------------
THEME_NAME="globecon"
THEME_COLOR_PRIMARY="#2563eb"   # Corporate Royal Blue
THEME_COLOR_ACCENT="#6366f1"    # Indigo / Violet Accent
THEME_BG_LIGHT="#f4f6f9"        # Academic Neutral Light Gray Surface

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Single Sign-On (SSO)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
# Local:      http://localhost:8000/admin/oauth2callback.php
# Production: https://academy.globecon.com/admin/oauth2callback.php
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_DOMAIN=""       # e.g., school.edu or leave blank for any Google account

# ------------------------------------------------------------------------------
# Authentication & Self-Registration Governance
# ------------------------------------------------------------------------------
# Allow users to sign in with their corporate or school email address
AUTH_ALLOW_EMAIL=1
# Enable self-registration ("email" for email-based verification)
AUTH_SELF_REGISTRATION="email"
# Active authentication plugins
AUTH_PLUGINS="email,manual,oauth2"

# ------------------------------------------------------------------------------
# Administrator Account (Initial Setup)
# ------------------------------------------------------------------------------
MOODLE_ADMIN_USER="globecon_admin"
MOODLE_ADMIN_PASSWORD="ChangeMe_StrictPassword123!"
MOODLE_ADMIN_EMAIL="admin@globecon.local"

# ------------------------------------------------------------------------------
# Database Configuration (MariaDB / MySQL / PostgreSQL)
# ------------------------------------------------------------------------------
DB_TYPE="mariadb"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="moodle"
DB_USER="root"
DB_PASSWORD=""
DB_PREFIX="mdl_"

# ------------------------------------------------------------------------------
# Moodle Data Directory (Must NOT be accessible from the public web server)
# ------------------------------------------------------------------------------
MOODLE_DATA_DIR="./server/moodledata"

# ------------------------------------------------------------------------------
# Mail / SMTP Notification Settings (For email registration & password reset)
# ------------------------------------------------------------------------------
MOODLE_SMTP_HOST=""
MOODLE_SMTP_PORT=587
MOODLE_SMTP_USER=""
MOODLE_SMTP_PASSWORD=""
MOODLE_SMTP_SECURITY="tls"
MOODLE_NOREPLY_ADDRESS="noreply@globecon.com"

# ------------------------------------------------------------------------------
# Docker Stack Settings (For containerized deployment)
# ------------------------------------------------------------------------------
DOCKER_APP_PORT=8000
DOCKER_DB_PORT=3306
DOCKER_MARIADB_ROOT_PASSWORD="ChangeMe_RootSecret123!"
